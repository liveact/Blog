---
import { Font } from 'astro:assets'

import { prod } from 'astro-pure/server'
import type { SiteMeta } from 'astro-pure/types'
import config from 'virtual:config'

type Props = SiteMeta

const { articleDate, description, ogImage, title } = Astro.props

const siteTitle = `${title} ${config.titleDelimiter} ${config.title}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(ogImage ? ogImage : config.socialCard, Astro.url).href
---

<meta charset='utf-8' />
<meta content='width=device-width, initial-scale=1.0, shrink-to-fit=no, viewport-fit=cover' name='viewport' />
<meta content='IE=edge' http-equiv='X-UA-Compatible' />
<title>{siteTitle}</title>

{/* Icons / Favicon */}
<link rel='icon' type={config.favicon.type} href={config.favicon.href} />
<link rel='shortcut icon' type={config.favicon.type} href={config.favicon.href} />
<link rel='icon' type='image/png' sizes='32x32' href='/favicon/favicon-32x32.png' />
<link rel='icon' type='image/png' sizes='16x16' href='/favicon/favicon-16x16.png' />
<link rel='apple-touch-icon' sizes='180x180' href='/favicon/apple-touch-icon.png' />
<link rel='manifest' href='/favicon/site.webmanifest' />

{/* Font preloads */}
<Font cssVariable='--font-satoshi' preload={[{ subset: 'latin', style: 'normal' }]} />
<style>
  body {
    font-family: var(--font-satoshi);
  }
</style>

{/* Canonical URL */}
<link rel='canonical' href={canonicalURL} />

{/* Primary Meta Tags */}
<meta content={siteTitle} name='title' />
<meta content={description} name='description' />
<meta content={config.author} name='author' />

{/* Theme Color */}
{/* <meta content='' name='theme-color' /> */}
<meta name='color-scheme' content='light dark' />

{/* Open Graph / Facebook */}
<meta content={articleDate ? 'article' : 'website'} property='og:type' />
<meta content={title} property='og:title' />
<meta content={description} property='og:description' />
<meta content={canonicalURL} property='og:url' />
<meta content={config.title} property='og:site_name' />
<meta content={config.locale.attrs} property='og:locale' />
<meta content={socialImageURL} property='og:image' />
<meta content='1200' property='og:image:width' />
<meta content='630' property='og:image:height' />
{
  articleDate && (
    <>
      <meta content={config.author} property='article:author' />
      <meta content={articleDate} property='article:published_time' />
    </>
  )
}

{/* Twitter */}
<meta content='summary_large_image' property='twitter:card' />
<meta content={canonicalURL} property='twitter:url' />
<meta content={title} property='twitter:title' />
<meta content={description} property='twitter:description' />
<meta content={socialImageURL} property='twitter:image' />

{/* Sitemap */}
<link href='/sitemap-index.xml' rel='sitemap' />

{/* RSS auto-discovery */}
<link
  rel='alternate'
  type='application/rss+xml'
  title={config.title}
  href={`${Astro.site}rss.xml`}
/>

<meta content={Astro.generator} name='generator' />

{/* Mermaid diagram rendering */}
<script type='module'>
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'
  mermaid.initialize({
    startOnLoad: true,
    theme: 'base',
    themeVariables: {
      fontSize: '14px',
      primaryColor: '#dbeafe',
      primaryTextColor: '#1e293b',
      primaryBorderColor: '#93c5fd',
      secondaryColor: '#e0f2fe',
      tertiaryColor: '#f0f9ff',
      lineColor: '#64748b',
      textColor: '#1e293b',
      edgeLabelBackground: '#ffffff',
      noteBkgColor: '#fefce8',
      noteTextColor: '#1e293b',
      noteBorderColor: '#fde68a'
    }
  })
</script>
<style is:global>
  :global(.dark) .mermaid {
    --mm-bg: #1e293b;
    --mm-text: #e2e8f0;
    --mm-edge-label-bg: #334155;
  }
  :global(.dark) .mermaid text,
  :global(.dark) .mermaid .nodeLabel,
  :global(.dark) .mermaid .label {
    color: #e2e8f0 !important;
    fill: #e2e8f0 !important;
  }
  :global(.dark) .mermaid .edgeLabel {
    background-color: #334155 !important;
    color: #e2e8f0 !important;
  }
  :global(.dark) .mermaid .edgeLabel p,
  :global(.dark) .mermaid .edgeLabel span {
    color: #e2e8f0 !important;
    fill: #e2e8f0 !important;
  }
  :global(.dark) .mermaid .edgeLabel rect {
    fill: #334155 !important;
    opacity: 1 !important;
  }
  :global(.dark) .mermaid .node rect,
  :global(.dark) .mermaid .node polygon,
  :global(.dark) .mermaid .node circle {
    fill: #1e3a5f !important;
    stroke: #60a5fa !important;
  }
  :global(.dark) .mermaid .node .label {
    color: #e2e8f0 !important;
    fill: #e2e8f0 !important;
  }
  :global(.dark) .mermaid .cluster rect {
    fill: #1e293b !important;
    stroke: #475569 !important;
  }
  :global(.dark) .mermaid .cluster span {
    color: #cbd5e1 !important;
    fill: #cbd5e1 !important;
  }
  :global(.dark) .mermaid line,
  :global(.dark) .mermaid .flowchart-link,
  :global(.dark) .mermaid .messageLine0,
  :global(.dark) .mermaid .messageLine1 {
    stroke: #94a3b8 !important;
  }
  :global(.dark) .mermaid marker path {
    fill: #94a3b8 !important;
  }
  :global(.dark) .mermaid .messageText,
  :global(.dark) .mermaid .loopText {
    fill: #e2e8f0 !important;
  }
  :global(.dark) .mermaid .loopLine {
    stroke: #475569 !important;
  }
  :global(.dark) .mermaid .actor-line {
    stroke: #64748b !important;
  }
  :global(.dark) .mermaid .actor {
    fill: #1e3a5f !important;
    stroke: #60a5fa !important;
  }
  :global(.dark) .mermaid .note {
    fill: #422006 !important;
    stroke: #a16207 !important;
  }
  :global(.dark) .mermaid .noteText {
    fill: #fef3c7 !important;
  }
  :global(.dark) .mermaid .activation0,
  :global(.dark) .mermaid .activation1,
  :global(.dark) .mermaid .activation2 {
    fill: #334155 !important;
    stroke: #60a5fa !important;
  }
  :global(.dark) .mermaid .labelBox {
    fill: #334155 !important;
    stroke: #475569 !important;
  }
  :global(.dark) .mermaid .labelText {
    fill: #e2e8f0 !important;
  }
  :global(.dark) .mermaid .sequenceNumber {
    fill: #e2e8f0 !important;
  }
  :global(.dark) .mermaid .rhombus,
  :global(.dark) .mermaid .node .label-container {
    fill: #1e3a5f !important;
  }
</style>

{
  /* User script*/
  prod && (
    <script>
      console.log( '%c Astro Theme Pure %c https://github.com/cworld1/astro-theme-pure/',
      'color:#fff;background:linear-gradient(90deg,#448bff,#44e9ff);padding:5px 0;',
      'color:#000;background:linear-gradient(90deg,#44e9ff,#ffffff);padding:5px 10px 5px 0px;' )
    </script>
  )
}
