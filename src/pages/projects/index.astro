---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.jpg'
import wechat from '@/assets/wechat-qrcode.jpg'

const headings = [
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/liveact'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '🛩️ FlyWing RC',
        description: '航模信息展示网站',
        links: [
          { type: 'github', href: 'https://github.com/liveact/flywing_rc' },
          { type: 'site', href: 'https://flywing.yugali.cn' }
        ]
      },
      {
        name: '📝 Blog',
        description: '基于 Astro + Astro Theme Pure 的个人博客',
        links: [
          { type: 'github', href: 'https://github.com/liveact/Blog' },
          { type: 'site', href: 'https://blog.yugali.cn' }
        ]
      }
    ]}
  />

  <h2 id='sponsorship'>Sponsorship</h2>
  <p>如果觉得内容对你有帮助，欢迎通过微信或支付宝赞助支持：</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat },
      { name: 'Alipay', icon: 'alipay', image: alipay }
    ]}
  />
  {/* <p>Chinese methods: <a href="https://afdian.com/a/cworld" target="_blank">Afadian</a></p> */}
  {/* <p>Global methods: <a href="https://ko-fi.com/cworld0" target="_blank">Ko-fi</a></p> */}
  <p>
    赞助后欢迎留言或联系我。我的邮箱是：（<code
      class='email-b64'
      title='点击进行 base64 转换'
      style='cursor:pointer;text-decoration:underline;'>eXVnYWxpLmx0dEBnbWFpbC5jb20=</code> 点击代码进行 base64 转换）。
  </p>
  <script is:inline>
    document.querySelector('.email-b64')?.addEventListener('click', function () {
      try {
        var decoded = atob(this.textContent?.trim() || '')
        if (decoded.includes('@')) {
          alert('邮箱：' + decoded)
        }
      } catch (e) {}
    })
  </script>
</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
